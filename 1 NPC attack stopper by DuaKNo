local function sanitizeConfig()
	CONFIG.Radius = math.clamp(CONFIG.Radius, 3, 500)
	CONFIG.Power = math.clamp(CONFIG.Power, 5, 1000)
	CONFIG.Depth = math.clamp(CONFIG.Depth, 3, 200)
	CONFIG.Height = math.clamp(CONFIG.Height, 2, 300)
	CONFIG.JailHeight = math.clamp(CONFIG.JailHeight, 20, 1500)
	CONFIG.Cooldown = math.clamp(CONFIG.Cooldown, 0.1, 10)
	if not table.find(K.MODES, CONFIG.ArmsMode) then CONFIG.ArmsMode = "Detach" end
	if not table.find(K.MODES, CONFIG.WeaponMode) then CONFIG.WeaponMode = "Detach" end
	if not table.find(K.HITMODES, CONFIG.HitMode) then CONFIG.HitMode = "Disable" end
	if not table.find(K.COLORS, CONFIG.AuraColor) then CONFIG.AuraColor = "Theme" end
	if not table.find(K.ALPHAS, CONFIG.AuraAlpha) then CONFIG.AuraAlpha = 0.75 end
	if not table.find(K.SIMVALUES, CONFIG.SimValue) then CONFIG.SimValue = 1e9 end
	if not table.find(K.PHYS, CONFIG.PhysMode) then CONFIG.PhysMode = "Off" end
	if not table.find(K.PROJMODES, CONFIG.ProjMode) then CONFIG.ProjMode = "Disable" end
	CONFIG.ProjRadius = math.clamp(CONFIG.ProjRadius, 5, 300)
	CONFIG.ProjMaxSize = math.clamp(CONFIG.ProjMaxSize, 1, 300)
	CONFIG.KeepAwayRadius = math.clamp(CONFIG.KeepAwayRadius, 2, 100)
	CONFIG.SmartRadius = math.clamp(CONFIG.SmartRadius, 30, 2000)
	if not table.find(K.SMARTACTIONS, CONFIG.SmartAction) then CONFIG.SmartAction = "Jail" end
	CONFIG.LastSlot = math.clamp(math.floor(CONFIG.LastSlot), 1, K.SLOTS)
	CONFIG.ReverseSpeed = math.clamp(CONFIG.ReverseSpeed, 1, 200)
	CONFIG.DecoyDistance = math.clamp(CONFIG.DecoyDistance, 30, 5000)
	if not table.find(K.DECOYDIRS, CONFIG.DecoyDir) then CONFIG.DecoyDir = "Up" end
	CONFIG.PanelW = math.clamp(math.floor(CONFIG.PanelW), 200, 480)
	CONFIG.PanelH = math.clamp(math.floor(CONFIG.PanelH), 220, 700)
end

K.VERSION = 3

local function encodeSettings()
	local data = { _v = K.VERSION, _t = os.time() }
	for _, k in ipairs(K.SAVE_KEYS) do data[k] = CONFIG[k] end
	return HttpService:JSONEncode(data)
end

local function applySettingsData(data, fromSlot)
	if type(data) ~= "table" then return false end
	if (tonumber(data._v) or 0) < K.VERSION then
		data.Depth = nil
		data.Underground = nil
	end
	for _, k in ipairs(K.SAVE_KEYS) do
		if not (fromSlot and k == "LastSlot") and data[k] ~= nil and type(data[k]) == type(CONFIG[k]) then
			CONFIG[k] = data[k]
		end
	end
	sanitizeConfig()
	return true
end

local function loadSettings()
	if not (isfile and readfile) then return end
	pcall(function()
		if isfile(K.SAVE_FILE) then
			applySettingsData(HttpService:JSONDecode(readfile(K.SAVE_FILE)))
		end
	end)
end

local saveQueued = false
local function saveSettings()
	if not writefile or saveQueued then return end
	saveQueued = true
	task.delay(0.5, function()
		saveQueued = false
		pcall(function() writefile(K.SAVE_FILE, encodeSettings()) end)
	end)
end

