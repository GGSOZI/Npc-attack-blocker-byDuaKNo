table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	local ec = edgeColor(now)
	if ui.panelStroke then ui.panelStroke.Color = ec end
	if ui.headerLine then ui.headerLine.BackgroundColor3 = ec end
	if ui.miniStroke then ui.miniStroke.Color = ec end

	local char = player.Character
