local function slotPath(i) return string.format("NPCAura_slot%d.json", i) end

local function slotInfo(i)
	if not (isfile and readfile) then return nil end
	local ok, t = pcall(function()
		if not isfile(slotPath(i)) then return nil end
		local data = HttpService:JSONDecode(readfile(slotPath(i)))
		if type(data) == "table" and data._v then return tonumber(data._t) or 0 end
		return nil
	end)
	return ok and t or nil
end

local function afterApply()
	if panel then panel.Size = UDim2.fromOffset(CONFIG.PanelW, CONFIG.PanelH) end
	releaseAll()
	applySim(CONFIG.SimRadius)
	refreshUI()
end

local function saveSlot(i)
	if not writefile then
		showStatus("No file support here: use Copy JSON", 4)
		return false
	end
	local ok = pcall(writefile, slotPath(i), encodeSettings())
	showStatus(ok and ("Saved to slot " .. i) or "Could not save the slot", 3)
	return ok
end

local function loadSlot(i)
	if not (isfile and readfile) then
		showStatus("No file support here: use import", 4)
		return false
	end
	local ok = pcall(function()
		local data = HttpService:JSONDecode(readfile(slotPath(i)))
		assert(data._v and applySettingsData(data, true))
	end)
	if ok then
		afterApply()
		showStatus("Loaded slot " .. i, 3)
	else
		showStatus("Slot " .. i .. " is empty", 3)
	end
	return ok
end

local function deleteSlot(i)
	local ok = pcall(function()
		if delfile and isfile and isfile(slotPath(i)) then
			delfile(slotPath(i))
		elseif writefile then
			writefile(slotPath(i), "{}")
		end
	end)
	showStatus(ok and ("Deleted slot " .. i) or "Could not delete", 3)
end

local function importJson(text)
	local ok = pcall(function()
		assert(applySettingsData(HttpService:JSONDecode(text), true))
	end)
	if ok then afterApply() end
	return ok
end

local function makeDraggable(handle, target, onTap)
	local dragging, dragInput, dragStart, startPos, moved = false, nil, nil, nil, false
	table.insert(connections, handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragInput, moved = true, i, false
			dragStart = i.Position
			startPos = target.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					local was = dragging
					dragging = false
					if was and not moved and onTap then onTap() end
				end
			end)
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(i)
		if not dragging then return end
		local isTouch = dragInput.UserInputType == Enum.UserInputType.Touch
		if (isTouch and i == dragInput) or (not isTouch and i.UserInputType == Enum.UserInputType.MouseMovement) then
			local d = i.Position - dragStart
			if d.Magnitude > 6 then moved = true end
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
end

local function copyText(text, btn)
	local f = setclipboard or toclipboard
	local ok = f and pcall(f, text)
	local old = btn.Text
	btn.Text = ok and "Copied!" or "No clipboard"
	task.delay(1.2, function() if btn.Parent then btn.Text = old end end)
end

local function setMinimized(v)
	panel.Visible = not v
	mini.Visible = v
	if v then mini.Position = panel.Position else panel.Position = mini.Position end
end

