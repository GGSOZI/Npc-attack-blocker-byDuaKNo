------------------------------------------------------------------ PART CLASSIFICATION
local STD = {}
for _, n in ipairs({
	"Head", "Torso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "UpperTorso", "LowerTorso",
	"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}) do STD[n] = true end

local WEAPON_WORDS = { "handle", "sword", "blade", "weapon", "gun", "staff", "axe", "spear", "katana", "club", "knife", "hammer", "bow", "scythe", "wand", "mace", "dagger" }
local HIT_WORDS = { "hit", "damage", "attack", "hurt", "slash", "swing", "aoe", "punch", "kick", "blast" }

local function isArmPart(p)
	if p:FindFirstAncestorOfClass("Accessory") or p:FindFirstAncestorOfClass("Tool") then return false end
	local n = p.Name:lower()
	if n:find("armor", 1, true) then return false end
	return n:find("arm", 1, true) ~= nil or n:find("hand", 1, true) ~= nil or n:find("fist", 1, true) ~= nil
end

local function isWeaponPart(p)
	if p:FindFirstAncestorOfClass("Tool") then return true end
	if p:FindFirstAncestorOfClass("Accessory") or STD[p.Name] then return false end
	local n = p.Name:lower()
	for _, w in ipairs(WEAPON_WORDS) do
		if n:find(w, 1, true) then return true end
	end
	return false
end

local function isHitPart(p)
	if p:FindFirstChildOfClass("TouchTransmitter") then return true end
	if STD[p.Name] or p:FindFirstAncestorOfClass("Accessory") then return false end
	local n = p.Name:lower()
	for _, w in ipairs(HIT_WORDS) do
		if n:find(w, 1, true) then return true end
	end
	return false
end

local function touching(joints, set)
	local out = {}
	for _, j in ipairs(joints) do
		local a, b
		pcall(function() a, b = j.Part0, j.Part1 end)
		if (a and set[a]) or (b and set[b]) then out[#out + 1] = j end
	end
	return out
end

local function refreshLists(st)
	st.listT = os.clock()
	local parts, joints, motors, scripts = {}, {}, {}, {}
	local armSet, wepSet, hitSet = {}, {}, {}
	local arms, weps, hits, hitVoid = {}, {}, {}, {}
	for _, d in ipairs(st.model:GetDescendants()) do
		if d:IsA("BasePart") then
			parts[#parts + 1] = d
			if isArmPart(d) then armSet[d] = true arms[#arms + 1] = d end
			if isWeaponPart(d) then wepSet[d] = true weps[#weps + 1] = d end
			if isHitPart(d) then
				hitSet[d] = true
				hits[#hits + 1] = d
				if not STD[d.Name] then hitVoid[#hitVoid + 1] = d end
			end
		elseif d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			joints[#joints + 1] = d
			if d:IsA("Motor6D") then motors[#motors + 1] = d end
		elseif d:IsA("LocalScript") or (d:IsA("Script") and d.RunContext == Enum.RunContext.Client) then
			scripts[#scripts + 1] = d
		end
	end
	st.parts, st.joints, st.motors, st.scripts = parts, joints, motors, scripts
	st.armParts, st.weapParts, st.hitParts, st.hitVoid = arms, weps, hits, hitVoid
	st.armJoints = touching(joints, armSet)
	st.weapJoints = touching(joints, wepSet)
	st.hitJoints = touching(joints, (function()
		local s = {}
		for _, p in ipairs(hitVoid) do s[p] = true end
		return s
	end)())
end

local function newState(m, hum, root)
	local st = { model = m, hum = hum, root = root, undo = {}, voided = {}, lastImpulse = 0, listT = 0 }
	st.cfg = setmetatable({}, { __index = CONFIG })
	refreshLists(st)
	return st
end

------------------------------------------------------------------ UNDO HELPERS
local function clear(st, key)
	local f = st.undo[key]
	if f then
		st.undo[key] = nil
		pcall(f)
	end
end

local function setProp(st, key, list, prop, value)
	if st.undo[key] == nil then
		local saved = {}
		for _, o in ipairs(list) do
			local ok, v = pcall(function() return o[prop] end)
			if ok then saved[o] = { v } end
		end
		st.undo[key] = function()
			for o, v in pairs(saved) do
				if o.Parent then pcall(function() o[prop] = v[1] end) end
			end
		end
	end
	for _, o in ipairs(list) do pcall(function() o[prop] = value end) end
end

local function disableJoints(st, key, list)
	setProp(st, key, list, "Enabled", false)
end

local function voidY()
	local ok, h = pcall(function() return Workspace.FallenPartsDestroyHeight end)
	h = ok and h or -500
	if h < -1e5 then h = -1e5 end
	return h - 60
end

local function voidParts(st, list, label)
	local vy = voidY()
	for _, p in ipairs(list) do
		if p.Parent then
			if not st.voided[p] then
				st.voided[p] = true
				stats.voided = stats.voided + 1
				log("Void " .. label .. ": " .. p.Name .. " of " .. st.model.Name)
			end
			p.CFrame = CFrame.new(p.Position.X, vy, p.Position.Z)
			p.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

local function release(st)
	for _, f in pairs(st.undo) do pcall(f) end
	st.undo = {}
	if st.home and st.root.Parent then
		pcall(function()
			st.root.CFrame = st.home + Vector3.new(0, 3, 0)
			st.root.AssemblyLinearVelocity = Vector3.zero
		end)
	end
	st.home = nil
	st.jail = nil
end

local function releaseAll()
	for m, st in pairs(tracked) do
		release(st)
		tracked[m] = nil
	end
end

------------------------------------------------------------------ PROCESS ONE NPC
local function process(st, myPos, now)
	local hum, root = st.hum, st.root
	local cfg = st.cfg
	if now - st.listT > 1 then refreshLists(st) end

	-- ===== STOP =====
	if cfg.ReverseWalk then
		setProp(st, "ws", { hum }, "WalkSpeed", -cfg.ReverseSpeed)
		setProp(st, "jp", { hum }, "JumpPower", 0)
		setProp(st, "jh", { hum }, "JumpHeight", 0)
		clear(st, "ar")
	elseif cfg.ZeroMotion then
		setProp(st, "ws", { hum }, "WalkSpeed", 0)
		setProp(st, "jp", { hum }, "JumpPower", 0)
		setProp(st, "jh", { hum }, "JumpHeight", 0)
		setProp(st, "ar", { hum }, "AutoRotate", false)
		pcall(function() hum:Move(Vector3.zero) end)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
	else
		clear(st, "ws") clear(st, "jp") clear(st, "jh") clear(st, "ar")
	end

	if cfg.SitLock then setProp(st, "sit", { hum }, "Sit", true) else clear(st, "sit") end
	if cfg.Sink then setProp(st, "hip", { hum }, "HipHeight", -cfg.Depth) else clear(st, "hip") end
	if cfg.TryKill then
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Dead)
			hum.Health = 0
		end)
	end
	if cfg.Limp then setProp(st, "limp", { hum }, "PlatformStand", true) else clear(st, "limp") end

	if cfg.KillAnims then
		local an = hum:FindFirstChildOfClass("Animator")
		if an then
			if not st.animConn then
				st.animConn = an.AnimationPlayed:Connect(function(tr) pcall(function() tr:Stop(0) end) end)
				st.undo.animhook = function()
					if st.animConn then st.animConn:Disconnect() st.animConn = nil end
				end
			end
			for _, tr in ipairs(an:GetPlayingAnimationTracks()) do pcall(function() tr:Stop(0) end) end
		end
	else
		clear(st, "animhook")
	end

	if cfg.NoScripts then
		setProp(st, "scr1", st.scripts, "Enabled", false)
		setProp(st, "scr2", st.scripts, "Disabled", true)
	else
		clear(st, "scr1") clear(st, "scr2")
	end

	if cfg.Shatter then disableJoints(st, "shatter", st.joints) else clear(st, "shatter") end

	if cfg.PhysMode ~= "Off" then
		setProp(st, "phys", st.parts, "CustomPhysicalProperties", K.PHYSVALUES[cfg.PhysMode])
	else
		clear(st, "phys")
	end

	if cfg.ToolUnequip then
		if st.undo.tools == nil then
			st.toolStore = {}
			st.undo.tools = function()
				for tool, parent in pairs(st.toolStore) do
					if parent and parent.Parent then
						pcall(function()
							tool.Enabled = true
							tool.Parent = parent
						end)
					end
				end
				st.toolStore = {}
			end
		end
		for _, c in ipairs(st.model:GetChildren()) do
			if c:IsA("Tool") then
				st.toolStore[c] = st.model
				pcall(function() c.Enabled = false end)
				c.Parent = nil
				log("Unequipped " .. c.Name .. " from " .. st.model.Name)
			end
		end
	else
		clear(st, "tools")
	end

	if cfg.NoHumanoid then
		if st.undo.nohum == nil then
			st.undo.nohum = function()
				if not hum.Parent and st.model.Parent then hum.Parent = st.model end
			end
		end
		if hum.Parent then hum.Parent = nil end
	else
		clear(st, "nohum")
	end

	-- ===== REMOVE PARTS =====
	if cfg.ArmsMode ~= "Off" then
		disableJoints(st, "armj", st.armJoints)
		setProp(st, "armt", st.armParts, "CanTouch", false)
		if cfg.ArmsMode == "Void" then voidParts(st, st.armParts, "arm") end
	else
		clear(st, "armj") clear(st, "armt")
	end

	if cfg.WeaponMode ~= "Off" then
		disableJoints(st, "wepj", st.weapJoints)
		setProp(st, "wept", st.weapParts, "CanTouch", false)
		if cfg.WeaponMode == "Void" then voidParts(st, st.weapParts, "weapon") end
	else
		clear(st, "wepj") clear(st, "wept")
	end

	if cfg.HitMode ~= "Off" then
		setProp(st, "hitt", st.hitParts, "CanTouch", false)
		if cfg.HitMode == "Void" then
			disableJoints(st, "hitj", st.hitJoints)
			voidParts(st, st.hitVoid, "hitbox")
		else
			clear(st, "hitj")
		end
	else
		clear(st, "hitt") clear(st, "hitj")
	end

	-- ===== MOVE: holds =====
	local needHold = cfg.VoidNPC or cfg.Jail or cfg.Underground or cfg.Freeze or cfg.Levitate
	if needHold then
		if not st.home then st.home = root.CFrame end
		local h = st.home
		local target
		if cfg.VoidNPC then
			target = CFrame.new(h.X, voidY(), h.Z)
		elseif cfg.Jail then
			target = h + Vector3.new(0, cfg.JailHeight, 0)
		elseif cfg.Underground then
			target = h - Vector3.new(0, cfg.Depth, 0)
		elseif cfg.Freeze then
			target = h
		else
			target = h + Vector3.new(0, cfg.Height + math.sin(now * 2) * 0.6, 0)
		end
		if cfg.VoidNPC or cfg.Underground then
			setProp(st, "cc", st.parts, "CanCollide", false)
		else
			clear(st, "cc")
		end
		root.CFrame = target
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		return
	end

	clear(st, "cc")
	if st.home then
		pcall(function()
			root.CFrame = st.home + Vector3.new(0, 3, 0)
			root.AssemblyLinearVelocity = Vector3.zero
		end)
		st.home = nil
	end

	-- ===== keep-away ring: nothing can stand inside this distance =====
	if cfg.KeepAway then
		local dd = root.Position - myPos
		local fl = Vector3.new(dd.X, 0, dd.Z)
		if fl.Magnitude < cfg.KeepAwayRadius and math.abs(dd.Y) < 40 then
			local dk = fl.Magnitude > 0.05 and fl.Unit or Vector3.new(1, 0, 0)
			local pos = Vector3.new(myPos.X + dk.X * cfg.KeepAwayRadius, root.Position.Y, myPos.Z + dk.Z * cfg.KeepAwayRadius)
			root.CFrame = CFrame.new(pos) * (root.CFrame - root.CFrame.Position)
			local v0 = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(dk.X * 20, v0.Y, dk.Z * 20)
		end
	end

	-- ===== MOVE: impulses =====
	local d = root.Position - myPos
	local flat = Vector3.new(d.X, 0, d.Z)
	local dir = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit
	local vel = root.AssemblyLinearVelocity

	if cfg.Wake then
		pcall(function() sethiddenproperty(root, "NetworkIsSleeping", false) end)
		if vel.Magnitude < 0.05 then
			root.AssemblyLinearVelocity = Vector3.new(0, 0.05, 0)
		end
	end

	if cfg.Pull and flat.Magnitude > 4 then
		root.AssemblyLinearVelocity = Vector3.new(-dir.X * cfg.Power * 0.5, vel.Y, -dir.Z * cfg.Power * 0.5)
	end
	if cfg.Push then
		root.AssemblyLinearVelocity = Vector3.new(dir.X * cfg.Power, math.max(vel.Y, 12), dir.Z * cfg.Power)
	end
	if cfg.Throw and now - st.lastImpulse >= cfg.Cooldown then
		st.lastImpulse = now
		local v2 = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v2.X, cfg.Power * 1.6, v2.Z)
	end
	if cfg.Fling and now - st.lastImpulse >= cfg.Cooldown then
		st.lastImpulse = now
		root.AssemblyLinearVelocity = Vector3.new(dir.X * cfg.Power * 6, cfg.Power * 2, dir.Z * cfg.Power * 6)
	end
	if cfg.Spin then
		root.AssemblyAngularVelocity = Vector3.new(0, 40, 0)
	end
end

------------------------------------------------------------------ SMART MODE + PROJECTILES
local Learned = { npcs = {}, anims = {}, parts = {} }
local PLACE = tostring(game.PlaceId)
K.LEARN_FILE = "NPCAura_learned.json"
local GENERIC = { Part = true, MeshPart = true, Handle = true, Union = true, Effect = true, Hitbox = true, Projectile = true }

local function sig(p)
	local n = p.Name
	if GENERIC[n] then
		local sz = p.Size
		return string.format("%s@%.1f,%.1f,%.1f", n, sz.X, sz.Y, sz.Z)
	end
	return n
end

local function countSet(t)
	local n = 0
	for _ in pairs(t) do n = n + 1 end
	return n
end

local function keysOf(t)
	local o = {}
	for k in pairs(t) do o[#o + 1] = k end
	table.sort(o)
	return o
end

local function loadLearned()
	if not (isfile and readfile) then return end
	pcall(function()
		if isfile(K.LEARN_FILE) then
			local all = HttpService:JSONDecode(readfile(K.LEARN_FILE))
			local mine = all[PLACE]
			if type(mine) == "table" then
				for _, kind in ipairs({ "npcs", "anims", "parts" }) do
					for _, v in ipairs(mine[kind] or {}) do Learned[kind][v] = true end
				end
			end
		end
	end)
end

local learnQueued = false
local function saveLearned()
	if not (writefile and readfile and isfile) or learnQueued then return end
	learnQueued = true
	task.delay(1, function()
		learnQueued = false
		pcall(function()
			local all = {}
			if isfile(K.LEARN_FILE) then
				local ok, d = pcall(function() return HttpService:JSONDecode(readfile(K.LEARN_FILE)) end)
				if ok and type(d) == "table" then all = d end
			end
			all[PLACE] = { npcs = keysOf(Learned.npcs), anims = keysOf(Learned.anims), parts = keysOf(Learned.parts) }
			writefile(K.LEARN_FILE, HttpService:JSONEncode(all))
		end)
	end)
end

local function learn(kind, value, why)
	if not value or value == "" or Learned[kind][value] then return false end
	Learned[kind][value] = true
	log("Learned " .. kind .. ": " .. tostring(value) .. (why and (" (" .. why .. ")") or ""))
	saveLearned()
	return true
end

local function clearLearned()
	Learned.npcs, Learned.anims, Learned.parts = {}, {}, {}
	saveLearned()
end
loadLearned()

local projQueue, projActive = {}, {}
local spawnHist = {}
local touchHist = {}
local panic = {}
local smartConns = {}

local function isCharPart(p)
	local m = p:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then return true end
		local par = m.Parent
		m = par and par:FindFirstAncestorOfClass("Model") or nil
	end
	return false
end

local function modelOf(part)
	local m = part:FindFirstAncestorOfClass("Model")
	while m and not m:FindFirstChildOfClass("Humanoid") do
		local par = m.Parent
		m = par and par:FindFirstAncestorOfClass("Model") or nil
	end
	return m
end

local function nearNpc(pos, r)
	for m in pairs(npcs) do
		if m.Parent then
			local rp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
			if rp and (rp.Position - pos).Magnitude <= r then return true end
		end
	end
	return false
end

local function projWanted()
	return CONFIG.ProjMode ~= "Off" or (CONFIG.SmartMode and next(Learned.parts) ~= nil)
end

table.insert(connections, Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("BasePart") and not d:IsA("Terrain") then
		spawnHist[#spawnHist + 1] = { p = d, t = os.clock(), pos = d.Position }
		if #spawnHist > 150 then table.remove(spawnHist, 1) end
		if #projQueue < 400 and projWanted() then projQueue[#projQueue + 1] = d end
	end
end))

local function projectileStep(myPos, now)
	local mode = CONFIG.ProjMode
	local smartParts = CONFIG.SmartMode and next(Learned.parts) ~= nil
	if mode == "Off" and not smartParts then
		projQueue = {}
		table.clear(projActive)
		return
	end
	local q = projQueue
	projQueue = {}
	local cam = Workspace.CurrentCamera
	for i = 1, math.min(#q, 150) do
		local p = q[i]
		if p.Parent and not projActive[p] and not (cam and p:IsDescendantOf(cam))
			and not p:FindFirstAncestorOfClass("Tool") and not isCharPart(p) then
			local ok, res = pcall(function()
				local dist = (p.Position - myPos).Magnitude
				if smartParts and dist <= CONFIG.SmartRadius and Learned.parts[sig(p)] then
					return "Void"
				end
				if mode ~= "Off" and dist <= CONFIG.ProjRadius and p.Size.Magnitude <= CONFIG.ProjMaxSize
					and (not CONFIG.OnlyNpcProj or nearNpc(p.Position, 80)) then
					return mode
				end
				return nil
			end)
			if ok and res then
				projActive[p] = { exp = now + 2.5, mode = res }
				stats.proj = stats.proj + 1
				log(res .. " projectile: " .. p.Name)
			end
		end
	end
	for p, e in pairs(projActive) do
		if not p.Parent or now > e.exp then
			projActive[p] = nil
		elseif e.mode == "Hide" then
			projActive[p] = nil
			pcall(function() p:Destroy() end)
		else
			pcall(function()
				p.CanTouch = false
				p.CanQuery = false
				p.CanCollide = false
				if e.mode == "Void" then
					p.CFrame = CFrame.new(p.Position.X, voidY(), p.Position.Z)
					p.AssemblyLinearVelocity = Vector3.zero
				end
			end)
		end
	end
end

-- learn what hurt the player
local function learnAnimsFrom(m)
	local hum = m:FindFirstChildOfClass("Humanoid")
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if not an then return end
	local got = false
	local tracks = an:GetPlayingAnimationTracks()
	for _, tr in ipairs(tracks) do
		local id = tr.Animation and tr.Animation.AnimationId
		if id and id ~= "" and tr.Priority.Name:find("Action") then
			learn("anims", id, m.Name)
			got = true
		end
	end
	if not got then
		for _, tr in ipairs(tracks) do
			local id = tr.Animation and tr.Animation.AnimationId
			local pr = tr.Priority.Name
			if id and id ~= "" and pr ~= "Idle" and pr ~= "Core" and pr ~= "Movement" then
				learn("anims", id, m.Name)
			end
		end
	end
end

local function onDamage(amount, died)
	if not (CONFIG.SmartMode and alive) then return end
	local char = player.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	local now = os.clock()
	local attackers = {}

	local hum = char:FindFirstChildOfClass("Humanoid")
	local tag = hum and hum:FindFirstChild("creator")
	if tag and tag:IsA("ObjectValue") and typeof(tag.Value) == "Instance" then
		local v = tag.Value
		local m = v:IsA("Model") and v or v:FindFirstAncestorOfClass("Model")
		if m and npcs[m] then attackers[m] = "creator tag" end
	end

	for i = #touchHist, 1, -1 do
		local e = touchHist[i]
		if now - e.t <= 0.6 and e.part.Parent then
			local m = modelOf(e.part)
			if m and m ~= char and npcs[m] then
				attackers[m] = attackers[m] or ("touched by " .. e.part.Name)
				if not STD[e.part.Name] then learn("parts", sig(e.part), "touched you") end
			elseif not m and not e.part.Anchored and nearNpc(e.part.Position, 80) then
				learn("parts", sig(e.part), "touched you")
			end
		end
	end

	for _, e in ipairs(spawnHist) do
		if now - e.t <= 1.5 and e.p.Parent and not STD[e.p.Name] and not e.p:FindFirstAncestorOfClass("Tool") and not isCharPart(e.p) then
			local ok, near = pcall(function()
				return (e.pos - myRoot.Position).Magnitude <= 45 and nearNpc(e.pos, 80)
			end)
			if ok and near then learn("parts", sig(e.p), "spawned next to you") end
		end
	end

	if next(attackers) == nil then
		local best, bd = nil, 30
		for m in pairs(npcs) do
			if m.Parent and m ~= char then
				local rp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
				if rp then
					local dd = (rp.Position - myRoot.Position).Magnitude
					if dd < bd then best, bd = m, dd end
				end
			end
		end
		if best then attackers[best] = "closest NPC" end
	end

	stats.hits = stats.hits + 1
	for m, why in pairs(attackers) do
		learn("npcs", m.Name, why)
		learnAnimsFrom(m)
		panic[m] = now + 12
	end
	log(string.format("Hit for %d%s", math.floor(amount), died and " (died)" or ""))
end

local lastHealth = 100
local function hookChar(char)
	for _, c in ipairs(smartConns) do pcall(function() c:Disconnect() end) end
	smartConns = {}
	touchHist = {}
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	if not hum then return end
	lastHealth = hum.Health
	table.insert(smartConns, hum.HealthChanged:Connect(function(h)
		if h < lastHealth - 0.01 then pcall(onDamage, lastHealth - h, h <= 0) end
		lastHealth = h
	end))
	local function hookPart(d)
		if d:IsA("BasePart") then
			table.insert(smartConns, d.Touched:Connect(function(o)
				if o:IsA("Terrain") or o:IsDescendantOf(char) then return end
				if o.Anchored then
					local m = modelOf(o)
					if not (m and m ~= char) then return end
				end
				touchHist[#touchHist + 1] = { part = o, t = os.clock() }
				if #touchHist > 30 then table.remove(touchHist, 1) end
			end))
		end
	end
	for _, d in ipairs(char:GetDescendants()) do hookPart(d) end
	table.insert(smartConns, char.DescendantAdded:Connect(hookPart))
end

-- block learned animations on every NPC around you
local smartHooked = setmetatable({}, { __mode = "k" })
local animTickT = 0
local function smartAnimTick(myPos, now)
	if not CONFIG.SmartMode or next(Learned.anims) == nil then return end
	if now - animTickT < 0.1 then return end
	animTickT = now
	for m in pairs(npcs) do
		if m.Parent then
			local rp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
			if rp and (rp.Position - myPos).Magnitude <= CONFIG.SmartRadius then
				local hum = m:FindFirstChildOfClass("Humanoid")
				local an = hum and hum:FindFirstChildOfClass("Animator")
				if an then
					if not smartHooked[an] then
						smartHooked[an] = true
						table.insert(connections, an.AnimationPlayed:Connect(function(tr)
							local id = tr.Animation and tr.Animation.AnimationId
							if id and Learned.anims[id] and CONFIG.SmartMode then pcall(function() tr:Stop(0) end) end
						end))
					end
					for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
						local id = tr.Animation and tr.Animation.AnimationId
						if id and Learned.anims[id] then pcall(function() tr:Stop(0) end) end
					end
				end
			end
		end
	end
end

-- forced profile for NPCs that hurt you (and every NPC with the same name)
local FORCE_KEYS = {
	KillAnims = true, ZeroMotion = true, ResetPose = true, Limp = true, Shatter = true, ToolUnequip = true,
	NoHumanoid = true, ArmsMode = "Void", WeaponMode = "Void", HitMode = "Void",
}
local ACTION_KEYS = { Jail = "Jail", Void = "VoidNPC", Freeze = "Freeze", Underground = "Underground" }

local function isForced(m, now)
	if not CONFIG.SmartMode then return false end
	if Learned.npcs[m.Name] then return true end
	local e = panic[m]
	return e ~= nil and e > now
end

local function applyForce(st, on)
	if on == (st.forced or false) and (not on or st.forcedAction == CONFIG.SmartAction) then return end
	st.forced = on
	st.forcedAction = CONFIG.SmartAction
	for k in pairs(FORCE_KEYS) do st.cfg[k] = nil end
	for _, k in pairs(ACTION_KEYS) do st.cfg[k] = nil end
	if on then
		for k, v in pairs(FORCE_KEYS) do st.cfg[k] = v end
		local ak = ACTION_KEYS[CONFIG.SmartAction]
		if ak then st.cfg[ak] = true end
	end
end

-- never treat yourself (or things attached to you, like a gun) as an NPC
local ANCHOR_CHECK = { "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso", "Head" }
local function anchoredNPC(m, root)
	if root.Anchored then return true end
	local pp = m.PrimaryPart
	if pp and pp.Anchored then return true end
	for _, n in ipairs(ANCHOR_CHECK) do
		local part = m:FindFirstChild(n)
		if part and part:IsA("BasePart") and part.Anchored then return true end
	end
	return false
end

local mineCache = setmetatable({}, { __mode = "k" })
local function isMine(m, root)
	local char = player.Character
	if not char then return false end
	if decoy.real and (m == decoy.real or m == decoy.clone) then return true end
	if m == char or m:IsDescendantOf(char) or char:IsDescendantOf(m) then return true end
	if m.Name == player.Name or m.Name == player.DisplayName then return true end
	local cam = Workspace.CurrentCamera
	if cam and m:IsDescendantOf(cam) then return true end
	if m:FindFirstAncestorOfClass("Tool") then return true end
	local ok, conn = pcall(function() return root:GetConnectedParts(true) end)
	if ok then
		for _, cp in ipairs(conn) do
			if cp:IsDescendantOf(char) then return true end
		end
	end
	return false
end

local function mineCached(m, root, now)
	local e = mineCache[m]
	if not e or now - e.t > 0.5 then
		e = { t = now, v = isMine(m, root) }
		mineCache[m] = e
	end
	return e.v
end

-- DECOY BODY: you control a local clone, the real body is parked far away and frozen
local function parkCFFor(cf)
	local d = CONFIG.DecoyDistance
	if CONFIG.DecoyDir == "Up" then
		return cf + Vector3.new(0, d, 0)
	elseif CONFIG.DecoyDir == "Down" then
		local y = math.max(cf.Y - d, voidY() + 80)
		return CFrame.new(cf.X, y, cf.Z) * (cf - cf.Position)
	end
	return cf + Vector3.new(d, 0, 0)
end

local function abortDecoy(msg, restoreCF)
	local clone, real = decoy.clone, decoy.real
	decoy = {}
	if real and real.Parent then
		pcall(function()
			local rr = real:FindFirstChild("HumanoidRootPart")
			if rr then rr.Anchored = false end
			if restoreCF then real:PivotTo(restoreCF) end
		end)
	end
	if clone then pcall(function() clone:Destroy() end) end
	if msg then showStatus(msg, 4) end
end

local function startDecoy()
	if decoy.active then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then
		showStatus("No living character for the decoy", 3)
		return
	end
	local cf = root.CFrame
	local ok, err = pcall(function()
		char.Archivable = true
		local clone = char:Clone()
		assert(clone, "clone failed")
		decoy.clone = clone
		decoy.real = char
		decoy.active = true
		clone.Parent = Workspace
		clone:PivotTo(cf)
		root.CFrame = parkCFFor(cf)
		root.AssemblyLinearVelocity = Vector3.zero
		root.Anchored = true
		player.Character = clone
		local cam = Workspace.CurrentCamera
		local chum = clone:FindFirstChildOfClass("Humanoid")
		if cam and chum then cam.CameraSubject = chum end
	end)
	if not ok then
		abortDecoy("Decoy failed: " .. tostring(err), cf)
		return
	end
	releaseAll()
	log("Decoy ON: real body parked " .. math.floor(CONFIG.DecoyDistance) .. " studs (" .. CONFIG.DecoyDir:lower() .. ")")
	showStatus("Decoy body ON", 3)
end

local function stopDecoy()
	if not decoy.active then return end
	decoy.stopping = true
	local clone, real = decoy.clone, decoy.real
	local cr = clone and clone:FindFirstChild("HumanoidRootPart")
	local backCF = cr and cr.CFrame
	if not (real and real.Parent) then
		abortDecoy("Real body is gone: decoy ended")
		return
	end
	pcall(function()
		local rr = real:FindFirstChild("HumanoidRootPart")
		if rr then
			rr.Anchored = false
			rr.AssemblyLinearVelocity = Vector3.zero
		end
		if backCF then real:PivotTo(backCF) end
		player.Character = real
		local rh = real:FindFirstChildOfClass("Humanoid")
		local cam = Workspace.CurrentCamera
		if cam and rh then cam.CameraSubject = rh end
	end)
	decoy = {}
	if clone then pcall(function() clone:Destroy() end) end
	showStatus("Decoy body OFF", 3)
end

local function toggleDecoy()
	if decoy.active then stopDecoy() else startDecoy() end
end

if player.Character then npcs[player.Character] = nil end
task.spawn(hookChar, player.Character)

local function step(myPos, now)
	local inAura, ownedN, ownKnown = 0, 0, false
	for m in pairs(npcs) do
		if not m.Parent then
			npcs[m] = nil
			tracked[m] = nil
		else
			local st = tracked[m]
			local hum = m:FindFirstChildOfClass("Humanoid") or (st and st.hum)
			local root = (st and st.root.Parent and st.root) or (hum and getRoot(m, hum))
			local forced, skip = false, false
			if hum and root then
				forced = isForced(m, now)
				local dd0 = root.Position - myPos
				local reach0 = (forced and CONFIG.SmartRadius or CONFIG.Radius) + 5
				if st or Vector3.new(dd0.X, 0, dd0.Z).Magnitude <= reach0 then
					if CONFIG.SkipAnchored and anchoredNPC(m, root) then
						skip = true
					elseif mineCached(m, root, now) then
						skip = true
					end
				end
			end
			if hum and root and hum.Health > 0 and (nameOK(m) or forced) and not skip then
				if st and st.root ~= root then
					release(st)
					tracked[m] = nil
					st = nil
				end
				local d = root.Position - myPos
				if st and st.home then d = st.home.Position - myPos end
				local flat = Vector3.new(d.X, 0, d.Z).Magnitude
				local inside
				local reach = forced and CONFIG.SmartRadius or CONFIG.Radius
				if st then
					inside = flat <= reach
				else
					inside = flat <= reach and math.abs(d.Y) <= math.max(reach, 25)
				end
				if inside then
					if not st then
						st = newState(m, hum, root)
						tracked[m] = st
					end
					applyForce(st, forced)
					local o = owned(root)
					pcall(process, st, myPos, now)
					inAura = inAura + 1
					if o ~= nil then
						ownKnown = true
						if o then ownedN = ownedN + 1 end
					end
				elseif st then
					release(st)
					tracked[m] = nil
				end
			elseif st then
				release(st)
				tracked[m] = nil
			end
		end
	end
	stats.inAura, stats.owned, stats.ownKnown = inAura, ownedN, ownKnown
end

