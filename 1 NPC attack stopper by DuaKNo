	accSim = accSim + dt
	if CONFIG.SimRadius and accSim >= 0.2 then
		accSim = 0
		applySim(true)
	end

	if CONFIG.Enabled and myRoot then
		step(myRoot.Position, now)
		pcall(projectileStep, myRoot.Position, now)
		pcall(smartAnimTick, myRoot.Position, now)
	end

	accStatus = accStatus + dt
	if accStatus >= 0.25 then
		accStatus = 0
		pcall(updateStatus)
	end
end))
pcall(updateStatus)

local function cleanup()
	pcall(stopDecoy)
	if ownersOrig ~= nil then
		pcall(function() settings().Physics.AreOwnersShown = ownersOrig end)
	end
	alive = false
	releaseAll()
	if CONFIG.SimRadius then applySim(false) end
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	for _, c in ipairs(smartConns) do pcall(function() c:Disconnect() end) end
	table.clear(connections)
	table.clear(npcs)
	if aura then pcall(function() aura:Destroy() end) end
	if gui then pcall(function() gui:Destroy() end) end
end

if getgenv then getgenv().NPCAuraCleanup = cleanup end

