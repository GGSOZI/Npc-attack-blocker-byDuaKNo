------------------------------------------------------------------ NETWORK OWNERSHIP TRICK
local function setPlayerProp(prop, v)
	if sethiddenproperty then
		local ok = pcall(sethiddenproperty, player, prop, v)
		if ok then return true end
	end
	return (pcall(function() player[prop] = v end))
end

local function applySim(on)
	if on then
		if not simOrig then
			simOrig = {}
			if gethiddenproperty then
				pcall(function() simOrig.r = gethiddenproperty(player, "SimulationRadius") end)
				pcall(function() simOrig.m = gethiddenproperty(player, "MaximumSimulationRadius") end)
			end
		end
		setPlayerProp("SimulationRadius", CONFIG.SimValue)
		setPlayerProp("MaximumSimulationRadius", CONFIG.SimValue)
		pcall(function() settings().Physics.AllowSleep = not CONFIG.AntiSleep end)
		pcall(function()
			settings().Physics.PhysicsEnvironmentalThrottle = CONFIG.AntiSleep
				and Enum.EnvironmentalPhysicsThrottle.Disabled or Enum.EnvironmentalPhysicsThrottle.DefaultAuto
		end)
	elseif simOrig then
		setPlayerProp("SimulationRadius", simOrig.r or 1000)
		setPlayerProp("MaximumSimulationRadius", simOrig.m or 1000)
		pcall(function() settings().Physics.AllowSleep = true end)
		pcall(function() settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnvironmentalPhysicsThrottle.DefaultAuto end)
		simOrig = nil
	end
end

local function owned(part)
	if isOwner then
		local ok, r = pcall(isOwner, part)
		if ok then return r end
	end
	return nil
end

local ownersOrig = nil
local function applyOwnerShow(on)
	if not on and ownersOrig == nil then return end
	pcall(function()
		local ph = settings().Physics
		if ownersOrig == nil then ownersOrig = ph.AreOwnersShown end
		ph.AreOwnersShown = on and true or false
	end)
end

