local function updateStatus()
	if not (ui.status and ui.status.Parent) then return end
	if ui.learned then
		ui.learned.Text = string.format("Learned here: %d NPC names, %d animations, %d parts", countSet(Learned.npcs), countSet(Learned.anims), countSet(Learned.parts))
	end
	if ui.stats then
		local own = stats.ownKnown and (tostring(stats.owned) .. " / " .. tostring(stats.inAura)) or "unknown (no isnetworkowner)"
		ui.stats.Text = "NPCs in aura: " .. stats.inAura .. "\nControlled by you: " .. own .. "\nParts voided: " .. stats.voided .. "\nProjectiles stopped: " .. stats.proj .. "\nHits learned from: " .. stats.hits
		ui.log.Text = #logLines > 0 and table.concat(logLines, "\n") or "Nothing removed yet. Set Arms / Weapon / Hitboxes to Void on the Stop tab to see parts being deleted here."
	end
	if statusMsg and os.clock() < statusUntil then
		ui.status.Text = statusMsg
		return
	end
	local txt
	if not CONFIG.Enabled then
		txt = "Aura off"
	else
		txt = "In aura: " .. stats.inAura
		if stats.ownKnown then
			txt = txt .. "  |  controlled: " .. stats.owned
			if stats.inAura > 0 and stats.owned == 0 then
				txt = txt .. "  (server owns them, physics methods may not reach the server)"
			end
		end
	end
	ui.status.Text = (decoy.active and "DECOY ON  |  " or "") .. txt
end

