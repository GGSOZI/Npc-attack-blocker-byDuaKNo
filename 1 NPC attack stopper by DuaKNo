	card = Color3.fromRGB(34, 28, 46),
	cardHi = Color3.fromRGB(54, 46, 74),
	field = Color3.fromRGB(18, 14, 26),
	line = Color3.fromRGB(62, 52, 86),
	accent = Color3.fromRGB(112, 70, 180),
	accentText = Color3.fromRGB(200, 165, 255),
	on = Color3.fromRGB(60, 140, 90),
	off = Color3.fromRGB(150, 60, 60),
	text = Color3.fromRGB(235, 230, 245),
	sub = Color3.fromRGB(165, 155, 185),
}
K.EDGE_KEYS = {
	Color3.fromRGB(75, 15, 125),
	Color3.fromRGB(255, 105, 180),
	Color3.fromRGB(235, 25, 45),
	Color3.fromRGB(255, 255, 255),
}
K.EDGE_PERIOD = 14
local function edgeColor(t)
	local keys = K.EDGE_KEYS
	local n = #keys
	local x = (t / K.EDGE_PERIOD % 1) * n
	local i = math.floor(x)
	local f = x - i
	f = f * f * (3 - 2 * f)
	return keys[i % n + 1]:Lerp(keys[(i + 1) % n + 1], f)
end

local function updateAura(myRoot, now, ec)
	if not (CONFIG.ShowAura and CONFIG.Enabled and myRoot) then
		if aura then aura.Transparency = 1 end
		return
	end
	if not (aura and aura.Parent) then
		aura = Instance.new("Part")
		aura.Name = "NPCAuraBall"
		aura.Shape = Enum.PartType.Ball
		aura.Anchored = true
		aura.CanCollide = false
		aura.CanQuery = false
		aura.CanTouch = false
		aura.CastShadow = false
		aura.Massless = true
		aura.Material = Enum.Material.Neon
		aura.Parent = Workspace.CurrentCamera
	end
	local r = CONFIG.Radius * 2 * (1 + math.sin(now * 3) * 0.02)
	aura.Size = Vector3.new(r, r, r)
	aura.CFrame = myRoot.CFrame
	aura.Transparency = CONFIG.AuraAlpha
	aura.Color = K.COLORVALUES[CONFIG.AuraColor] or ec
end

